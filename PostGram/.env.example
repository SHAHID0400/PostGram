# Public Appwrite identifiers. Never put API keys or secrets in VITE_ variables:
# every VITE_ value is embedded in the browser bundle.
VITE_APPWRITE_URL=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_DATABASE_ID=your-database-id
VITE_APPWRITE_COLLECTION_ID=your-posts-collection-id
VITE_APPWRITE_BUCKET_ID=your-storage-bucket-id

# Social collections. Defaults match the names in APPWRITE_SOCIAL_SETUP.md.
VITE_APPWRITE_PROFILES_COLLECTION_ID=profiles
VITE_APPWRITE_FOLLOWS_COLLECTION_ID=follows
VITE_APPWRITE_MESSAGES_COLLECTION_ID=messages
VITE_APPWRITE_COMMENTS_COLLECTION_ID=comments

# Server-only Vercel API settings for protected admin operations.
# Set these in Vercel project environment variables and in local .env.local.
# Never prefix the API key with VITE_ or expose it to the browser.
# Grant users.read, documents.read, documents.write, files.read, and files.write.
# Direct Client Mode also requires the Appwrite `admin` label to have the
# necessary read/write permissions on the profiles, posts, comments, and media
# bucket. The client fallback never uses or exposes this server API key.
APPWRITE_URL=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_DATABASE_ID=your-database-id
APPWRITE_POSTS_COLLECTION_ID=your-posts-collection-id
APPWRITE_PROFILES_COLLECTION_ID=profiles
APPWRITE_COMMENTS_COLLECTION_ID=comments
APPWRITE_BUCKET_ID=your-storage-bucket-id
APPWRITE_API_KEY=server-only-key-with-required-appwrite-scopes
